#!/bin/bash
set -euo pipefail

CONFIG="/etc/boghche/config.json"
DEFAULT_LANS='["192.168.0.0/16","172.16.0.0/16","172.18.0.0/16"]'
DASHBOARD="/usr/local/lib/boghche/dashboard.sh"

[ -f "$DASHBOARD" ] && source "$DASHBOARD" || true

for module in \
  /usr/local/lib/boghche/services/monitor_service.sh \
  /usr/local/lib/boghche/services/firewall_service.sh \
  /usr/local/lib/boghche/services/dns_service.sh \
  /usr/local/lib/boghche/services/maintenance_service.sh; do
  [ -f "$module" ] && source "$module"
done

need_root() {
  if [ "${EUID}" -ne 0 ]; then
    echo "Please run with sudo: sudo boghche"
    exit 1
  fi
}

pause() { echo; gum confirm "Return?" >/dev/null 2>&1 || true; }

ask() {
  local label="$1" default="${2:-}"
  if [ -n "$default" ]; then gum input --value "$default" --placeholder "$label"; else gum input --placeholder "$label"; fi
}

ask_password() { gum input --password --placeholder "$1"; }
yn() { gum confirm "$1" && echo true || echo false; }

configure_tunnel() {
  need_root
  clear
  gum style --foreground 45 --bold "Tunnel Configuration Wizard"

  MODE_CHOICE=$(gum choose "Route-based VPN / VTI" "Policy-based VPN")
  [ "$MODE_CHOICE" = "Route-based VPN / VTI" ] && MODE="route" || MODE="policy"

  CONN_NAME=$(ask "Connection name" "fgt")
  LEFT_ID=$(ask "Local public IP / leftid")
  LEFT_IP=$(ask "Local public IP / left" "$LEFT_ID")
  RIGHT_IP=$(ask "Remote peer public IP / right")
  RIGHT_ID=$(ask "Remote peer ID / rightid" "$RIGHT_IP")
  PSK=$(ask_password "Pre-shared key / PSK")
  IKE=$(ask "IKE proposal" "aes256-sha256-modp2048!")
  ESP=$(ask "ESP proposal" "aes256-sha256!")
  DPD_DELAY=$(ask "DPD delay" "10s")
  DPD_TIMEOUT=$(ask "DPD timeout" "30s")
  REKEY=$(yn "Enable rekey?")
  WAN_IF=$(ask "WAN interface" "eth0")
  NAT=$(yn "Enable NAT/MASQUERADE?")

  VTI_IF="vti0"; VTI_ADDR="10.11.11.2/30"; VTI_REMOTE="10.11.11.1"; VTI_MARK="42"; MTU="1400"
  ROUTE_SUBNETS="[]"; LOCAL_SUBNET=""; REMOTE_SUBNET=""

  if [ "$MODE" = "route" ]; then
    VTI_IF=$(ask "VTI interface name" "$VTI_IF")
    VTI_ADDR=$(ask "VTI local address with CIDR" "$VTI_ADDR")
    VTI_REMOTE=$(ask "VTI remote gateway address" "$VTI_REMOTE")
    VTI_MARK=$(ask "VTI mark/key" "$VTI_MARK")
    MTU=$(ask "VTI MTU" "$MTU")
    EXTRA_ROUTE=$(ask "Optional extra routed subnet, empty if none")
    [ -n "$EXTRA_ROUTE" ] && ROUTE_SUBNETS=$(jq -cn --arg subnet "$EXTRA_ROUTE" '[ $subnet ]')
  else
    LOCAL_SUBNET=$(ask "Local protected subnet / leftsubnet" "0.0.0.0/0")
    REMOTE_SUBNET=$(ask "Remote protected subnet / rightsubnet" "0.0.0.0/0")
  fi

  UNBOUND="false"; UNBOUND_LISTEN_IP=""; DNS_UPSTREAMS='[]'
  if [ "$MODE" = "route" ]; then
    UNBOUND=$(yn "Configure Unbound DNS-over-TLS on the VTI IP?")
    if [ "$UNBOUND" = "true" ]; then
      DEFAULT_VTI_IP="${VTI_ADDR%%/*}"
      UNBOUND_LISTEN_IP=$(ask "Unbound listen IP" "$DEFAULT_VTI_IP")
      PRIMARY_DNS=$(ask "Primary DoT upstream" "8.8.8.8@853#dns.google")
      SECONDARY_DNS=$(ask "Secondary DoT upstream" "8.8.4.4@853#dns.google")
      DNS_UPSTREAMS=$(jq -cn --arg p "$PRIMARY_DNS" --arg s "$SECONDARY_DNS" '[ $p, $s ]')
    fi
  fi

  mkdir -p /etc/boghche
  jq -n \
    --arg mode "$MODE" --arg conn_name "$CONN_NAME" --arg left "$LEFT_IP" --arg leftid "$LEFT_ID" \
    --arg right "$RIGHT_IP" --arg rightid "$RIGHT_ID" --arg psk "$PSK" --arg ike "$IKE" --arg esp "$ESP" \
    --arg dpd_delay "$DPD_DELAY" --arg dpd_timeout "$DPD_TIMEOUT" --arg rekey "$REKEY" \
    --arg wan_if "$WAN_IF" --arg nat "$NAT" --arg vti_if "$VTI_IF" --arg vti_addr "$VTI_ADDR" \
    --arg vti_remote "$VTI_REMOTE" --arg vti_mark "$VTI_MARK" --arg mtu "$MTU" \
    --arg local_subnet "$LOCAL_SUBNET" --arg remote_subnet "$REMOTE_SUBNET" \
    --arg unbound "$UNBOUND" --arg unbound_listen_ip "$UNBOUND_LISTEN_IP" \
    --argjson dns_upstreams "$DNS_UPSTREAMS" --argjson default_lans "$DEFAULT_LANS" --argjson route_subnets "$ROUTE_SUBNETS" \
    '{mode:$mode,conn_name:$conn_name,left:$left,leftid:$leftid,right:$right,rightid:$rightid,psk:$psk,ike:$ike,esp:$esp,dpd_delay:$dpd_delay,dpd_timeout:$dpd_timeout,rekey:($rekey=="true"),wan_if:$wan_if,nat:($nat=="true"),vti_if:$vti_if,vti_addr:$vti_addr,vti_remote:$vti_remote,vti_mark:$vti_mark,mtu:$mtu,default_lans:$default_lans,route_subnets:$route_subnets,local_subnet:$local_subnet,remote_subnet:$remote_subnet,unbound:($unbound=="true"),unbound_listen_ip:$unbound_listen_ip,dns_upstreams:$dns_upstreams}' > "$CONFIG"
  chmod 600 "$CONFIG"
  gum style --foreground 46 "Configuration saved to $CONFIG"
  echo
  gum style --foreground 45 "Applying tunnel configuration now..."
  apply_tunnel
}

generate_ipsec() {
  [ -f "$CONFIG" ] || { gum style --foreground 196 "No config found."; return 1; }
  /usr/local/lib/boghche/ipsec.sh
}

tunnel_is_connected() {
  ipsec statusall 2>/dev/null | grep -q 'ESTABLISHED'
}

apply_tunnel() {
  [ -f "$CONFIG" ] || { gum style --foreground 196 "No config found. Run Configure first."; return 1; }

  if ! systemctl restart boghche; then
    gum style --foreground 196 "Failed to apply Boghche tunnel configuration."
    journalctl -u boghche -n 30 --no-pager || true
    return 1
  fi

  sleep 2
  if tunnel_is_connected; then
    gum style --foreground 46 "Tunnel configuration applied and IPsec is connected."
  else
    gum style --foreground 220 "Configuration applied, but IPsec is not connected yet."
    ipsec statusall 2>/dev/null | grep -E 'Security Associations|connecting|ESTABLISHED|INSTALLED' || true
  fi
}

start_tunnel() {
  gum style --foreground 45 "Start / Apply Current Configuration"
  apply_tunnel
}

stop_tunnel() {
  systemctl stop boghche || true
  ipsec stop || true
  ip link del "$(jq -r '.vti_if // "vti0"' "$CONFIG" 2>/dev/null || echo vti0)" 2>/dev/null || true
  gum style --foreground 196 "Tunnel stopped."
}

restart_tunnel() {
  gum style --foreground 45 "Restart Tunnel"
  stop_tunnel
  sleep 2
  apply_tunnel
}

tunnel_status() {
  clear
  gum style --foreground 45 --bold "Tunnel Status"
  echo "Boghche service : $(systemctl is-active boghche 2>/dev/null || true)"
  echo "IPsec service   : $(systemctl is-active strongswan-starter 2>/dev/null || true)"
  echo
  ipsec statusall 2>/dev/null | grep -E 'Security Associations|ESTABLISHED|INSTALLED|bytes_i|bytes_o|rekeying' || true
  echo
  ip -br addr show "$(jq -r '.vti_if // "vti0"' "$CONFIG" 2>/dev/null || echo vti0)" 2>/dev/null || true
  echo
  ip rule show || true
  echo
  ip route show table vti 2>/dev/null || true
}

add_route() {
  [ -f "$CONFIG" ] || { gum style --foreground 196 "No config found."; return; }
  route=$(gum input --placeholder "Subnet to route through tunnel")
  [ -z "$route" ] && return
  tmp=$(mktemp)
  jq --arg route "$route" '.route_subnets = ((.route_subnets // []) + [$route] | unique)' "$CONFIG" > "$tmp"
  mv "$tmp" "$CONFIG"
  gum style --foreground 46 "Route added: $route"
  apply_tunnel
}

tunnel_menu() {
  while true; do
    clear; gum style --foreground 45 --bold "Tunnel Service"
    choice=$(gum choose \
      "Configure / Apply Tunnel" \
      "Start / Apply Current Config" \
      "Restart Tunnel" \
      "Stop Tunnel" \
      "Add Routed Subnet" \
      "Tunnel Status" \
      "Back")
    case "$choice" in
      "Configure / Apply Tunnel") configure_tunnel; pause ;;
      "Start / Apply Current Config") start_tunnel; pause ;;
      "Restart Tunnel") restart_tunnel; pause ;;
      "Stop Tunnel") stop_tunnel; pause ;;
      "Add Routed Subnet") add_route; pause ;;
      "Tunnel Status") tunnel_status; pause ;;
      "Back") return ;;
    esac
  done
}

logs_menu() {
  clear
  gum style --foreground 45 --bold "Boghche Logs"
  journalctl -u boghche -u strongswan-starter -n 160 --no-pager || true
  pause
}

fallback_monitor_menu() { clear; ipsec statusall || true; echo; grep '^Xfrm' /proc/net/xfrm_stat || true; pause; }
fallback_firewall_menu() { clear; iptables -vnL || true; pause; }
fallback_dns_menu() { clear; systemctl status unbound --no-pager || true; pause; }
fallback_maintenance_menu() { clear; jq . "$CONFIG" 2>/dev/null || echo "No config"; pause; }

main_loop() {
  need_root
  while true; do
    if declare -F render_dashboard >/dev/null 2>&1; then render_dashboard; else clear; echo "[1] Tunnel [2] Monitor [3] Firewall [4] DNS [5] Logs [6] Maintenance [Q] Quit"; fi
    ACTION=$(gum input --placeholder "Select service: 1-6 or q")
    case "${ACTION,,}" in
      1|t|tunnel) tunnel_menu;; 2|m|monitor) declare -F monitor_menu >/dev/null && monitor_menu || fallback_monitor_menu;; 3|f|firewall) declare -F firewall_menu >/dev/null && firewall_menu || fallback_firewall_menu;; 4|u|unbound|dns) declare -F dns_menu >/dev/null && dns_menu || fallback_dns_menu;; 5|l|logs) logs_menu;; 6|maintenance|tools) declare -F maintenance_menu >/dev/null && maintenance_menu || fallback_maintenance_menu;; q|quit|exit) exit 0;; *) gum style --foreground 196 "Unknown option: $ACTION"; sleep 1;;
    esac
  done
}

main_loop
